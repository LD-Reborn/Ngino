# Ngino Client Environment Variables (deploy/docker/client/compose.yml)

# Server base URL (required)
NGINO_SERVER=https://ai.example.tld

# Client key created in the admin UI (required)
NGINO_TOKEN=<client-key>

# Identifies this machine on the server
# NGINO_CLIENT_ID=ngino-docker-client

# Upstream Ollama URL on this machine (used directly in Ollama mode and as
# fallback target in llama.cpp mode)
# NGINO_UPSTREAM=http://localhost:11434

# Use llama.cpp Docker containers instead of Ollama for inferencing.
# Requires NGINO_USE_OLLAMA_MODELS_PATH below and a running Docker daemon.
# NGINO_USE_LLAMA_CPP_VIA_DOCKER=false

# Path to the Ollama models directory (manifests/blobs) on the HOST. Always
# mounted read-only into the client container at the identical path; it is
# required for llama.cpp mode because the path is passed to sibling
# `docker run -v` calls, which resolve against the host filesystem.
NGINO_USE_OLLAMA_MODELS_PATH=/usr/share/ollama/.ollama/models

# llama.cpp Docker image; defaults to auto-detected (rocm/cuda/cpu).
# For NVIDIA GPUs set it explicitly so spawned containers get --gpus=all:
# NGINO_LLAMA_CPP_DOCKER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# For AMD ROCm also uncomment the devices block in compose.yml:
# NGINO_LLAMA_CPP_DOCKER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm

# Base port for llama.cpp containers
# NGINO_LLAMA_CPP_BASE_PORT=8081

# Parallel slots per llama.cpp container (empty = llama.cpp default)
# NGINO_LLAMA_CPP_PARALLEL=

# Seconds before llama.cpp is retried after a failed container start
# NGINO_LLAMA_CPP_FALLBACK_COOLDOWN_SECONDS=180
