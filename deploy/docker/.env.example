# Ngino Server Environment Variables

# Shared token for authentication (required for production)
NGINO_TOKEN=change-me

# Tunnel and status path settings
# NGINO_TUNNEL_PATH=/_ngino/tunnel
# NGINO_STATUS_PATH=/_ngino/status

# Chunk size for streaming (default: 65536)
# NGINO_CHUNK_SIZE=65536

# Secure cookies setting (default: true, set to false for HTTP development)
# NGINO_SECURE_COOKIES=true

# Embedding cache path
# NGINO_EMBEDDING_CACHE_PATH=/app/App_Data/embedding-cache.sqlite

# Management database path
# NGINO_MANAGEMENT_DATABASE_PATH=/app/App_Data/management.sqlite

# MySQL connection string (used by Elmah for error logging)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=elmah
MYSQL_USER=elmah
MYSQL_PASSWORD=elmah

# Ngino Client Environment Variables
# (Set these when running the client container)

# Server URL for WebSocket tunnel connection
# NGINO_SERVER=http://your-server:5050/_ngino/tunnel

# Token for authentication (must match server token)
# NGINO_TOKEN=change-me

# Upstream Ollama URL on the GPU machine
# NGINO_UPSTREAM=http://localhost:11434

# Client ID (optional, defaults to hostname)
# NGINO_CLIENT_ID=gpu-node-01

# Use Llama.cpp via Docker instead of direct Ollama
# NGINO_USE_LLAMA_CPP_VIA_DOCKER=false

# Parallel slots for llama.cpp (if using Docker mode)
# NGINO_LLAMA_CPP_PARALLEL=4
